{
  "name": "@axiom-games/branchfall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BRANCHFALL — squad staged-survival runner on the Axiom Games Reveal Engine",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "enumerate": "node tools/enumerate.mjs",
    "enumerate:markdown": "node tools/enumerate.mjs --markdown",
    "enumerate:json": "node tools/enumerate.mjs --json",
    "montecarlo": "node tools/montecarlo.mjs",
    "transcript": "node tools/transcript.mjs",
    "fixture": "node tools/transcript.mjs --fixture",
    "docs:sync": "node tools/sync-docs.mjs",
    "docs:check": "node tools/sync-docs.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && node tools/enumerate.mjs --quiet && npm run docs:check && npm test && npm run montecarlo -- --rounds 100000"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
